<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nossos Jogos - +LUDUS</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <%- include('./header') %>

    <!-- Games Page Title -->
    <section class="games-page-title">
        <div class="container">
            <div class="page-header-content">
                <div class="page-icon">🎮</div>
                <h2>Jogos Educacionais</h2>
            </div>
            <h1>Nossos Jogos</h1>
            <p>Explore nossa coleção de jogos educacionais acessíveis desenvolvidos com carinho para todas as crianças.</p>
        </div>
    </section>

    <!-- Search and Filter Section -->
    <section class="games-filter-section">
        <div class="container">
            <!-- Search Bar -->
            <div class="search-container">
                <input type="text" class="search-input" placeholder="🔍">
            </div>

            <!-- Category Filters -->
            <div class="filters-container">
                <div class="filter-label">
                    <span class="filter-icon">⚙️</span>
                    <span>Filtrar</span>
                </div>
                <div class="filter-buttons">
                    <button class="filter-btn active" data-filter="all">Todos</button>
                    <button class="filter-btn" data-filter="linguagens">Linguagens</button>
                    <button class="filter-btn" data-filter="matematica">Matemática</button>
                    <button class="filter-btn" data-filter="natureza">Ciências da Natureza</button>
                    <button class="filter-btn" data-filter="humanas">Ciências Humanas</button>
                    <button class="filter-btn" data-filter="arte">Arte</button>
                    <button class="filter-btn" data-filter="portugues">Língua Portuguesa</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Games Grid Section -->
    <section class="games-grid-section">
        <div class="container">
            <p class="games-counter"><%= jogos.length %> jogos encontrados</p>
            
            <div class="games-grid">
                <% jogos.forEach(jogo => { %>
                    <div class="game-card-full">
                        <div class="game-image">
                            <% if (jogo.icone_url) { %>
                                <img src="<%= jogo.icone_url %>" alt="<%= jogo.nome %>" style="width: 100%; height: 100%; object-fit: cover;">
                            <% } else { %>
                                <div class="game-placeholder">🎮</div>
                            <% } %>
                        </div>
                        <div class="game-info">
                            <h3><%= jogo.nome %></h3>
                            <p class="game-description"><%= jogo.descricao || 'Jogo educacional divertido e interativo' %></p>
                            <div class="game-tags">
                                <% if (jogo.categorias && jogo.categorias.length > 0) { %>
                                    <% jogo.categorias.forEach(cat => { %>
                                        <span class="tag"><%= cat.nome || cat %></span>
                                    <% }); %>
                                <% } else { %>
                                    <span class="tag">Educacional</span>
                                <% } %>
                            </div>
                            <a href="/jogo/<%= jogo._id %>" class="btn-play">🎮 Abrir Jogo</a>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <%- include('./footer') %>

    <script>
        // Filtro e Pesquisa de Jogos
        const searchInput = document.querySelector('.search-input');
        const filterButtons = document.querySelectorAll('.filter-btn');
        const gameCards = document.querySelectorAll('.game-card-full');
        const gamesCounter = document.querySelector('.games-counter');
        
        let currentFilter = 'all';

        // Função para normalizar texto (remover acentos)
        function normalizeText(text) {
            return text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
        }

        // Função para verificar se um jogo corresponde ao filtro
        function matchesFilter(card, filter) {
            if (filter === 'all') return true;
            
            const tags = card.querySelectorAll('.tag');
            const filterMap = {
                'linguagens': ['Linguagens', 'Linguagem'],
                'matematica': ['Matemática', 'Matematica'],
                'natureza': ['Ciências da Natureza', 'Ciencias da Natureza'],
                'humanas': ['Ciências Humanas', 'Ciencias Humanas'],
                'arte': ['Arte'],
                'portugues': ['Língua Portuguesa', 'Lingua Portuguesa', 'Português', 'Portugues']
            };

            const targetCategories = filterMap[filter] || [];
            
            for (let tag of tags) {
                const tagText = tag.textContent.trim();
                for (let category of targetCategories) {
                    if (normalizeText(tagText) === normalizeText(category)) {
                        return true;
                    }
                }
            }
            return false;
        }

        // Função para verificar se um jogo corresponde à pesquisa
        function matchesSearch(card, searchTerm) {
            if (!searchTerm) return true;
            
            const normalized = normalizeText(searchTerm);
            const title = normalizeText(card.querySelector('h3').textContent);
            const description = normalizeText(card.querySelector('.game-description').textContent);
            const tags = Array.from(card.querySelectorAll('.tag')).map(t => normalizeText(t.textContent));
            
            return title.includes(normalized) || 
                   description.includes(normalized) || 
                   tags.some(tag => tag.includes(normalized));
        }

        // Função para atualizar a exibição dos jogos
        function updateGames() {
            const searchTerm = searchInput.value;
            let visibleCount = 0;

            gameCards.forEach(card => {
                const matchFilter = matchesFilter(card, currentFilter);
                const matchSearch = matchesSearch(card, searchTerm);
                
                if (matchFilter && matchSearch) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // Atualizar contador
            gamesCounter.textContent = `${visibleCount} jogo${visibleCount !== 1 ? 's' : ''} encontrado${visibleCount !== 1 ? 's' : ''}`;
        }

        // Event listeners para filtros
        filterButtons.forEach(button => {
            button.addEventListener('click', () => {
                // Remover classe active do botão anterior
                document.querySelector('.filter-btn.active').classList.remove('active');
                
                // Adicionar classe active ao botão clicado
                button.classList.add('active');
                
                // Atualizar filtro atual
                currentFilter = button.dataset.filter;
                
                // Atualizar exibição
                updateGames();
            });
        });

        // Event listener para pesquisa
        searchInput.addEventListener('input', () => {
            updateGames();
        });

        // Inicializar
        updateGames();
    </script>
</body>
</html>
