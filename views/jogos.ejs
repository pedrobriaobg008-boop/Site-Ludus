<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nossos Jogos - +LUDUS</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <%- include('./header') %>

    <!-- Games Page Title -->
    <section class="games-page-title">
        <div class="container">
            <div class="page-header-content">
                <div class="page-icon">🎮</div>
                <h2>Jogos Educacionais</h2>
            </div>
            <h1>Nossos Jogos</h1>
            <p>Explore nossa coleção de jogos educacionais acessíveis desenvolvidos com carinho para todas as crianças.</p>
        </div>
    </section>

    <!-- Search and Filter Section -->
    <section class="games-filter-section">
        <div class="container">
            <!-- Search Bar -->
            <div class="search-container">
                <input type="text" class="search-input" placeholder="🔍 Procurar jogos...">
            </div>

            <!-- Category Filters -->
            <div class="filters-container">
                <div class="filter-label">
                    <span class="filter-icon">⚙️</span>
                    <span>Filtrar</span>
                </div>
                <div class="filter-buttons">
                    <button class="filter-btn active" data-filter="all">Todos</button>
                    <button class="filter-btn" data-filter="linguagens">Linguagens</button>
                    <button class="filter-btn" data-filter="matematica">Matemática</button>
                    <button class="filter-btn" data-filter="natureza">Ciências da Natureza</button>
                    <button class="filter-btn" data-filter="humanas">Ciências Humanas</button>
                    <button class="filter-btn" data-filter="arte">Arte</button>
                    <button class="filter-btn" data-filter="portugues">Língua Portuguesa</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Games Grid -->
    <section class="games-grid-section">
        <div class="container">
            <div class="games-grid">
                <!-- Exemplo de Cards de Jogos -->
                <div class="game-card-full">
                    <div class="game-image">
                        <div class="game-placeholder">🎨</div>
                    </div>
                    <div class="game-info">
                        <h3>Mundo das Cores</h3>
                        <p class="game-description">Aprenda sobre cores e conceitos básicos de forma divertida e interativa.</p>
                        <div class="game-tags">
                            <span class="tag">Linguagens</span>
                            <span class="tag">Arte</span>
                        </div>
                        <button class="btn-play">Jogar Agora</button>
                    </div>
                </div>

                <div class="game-card-full">
                    <div class="game-image">
                        <div class="game-placeholder">🔢</div>
                    </div>
                    <div class="game-info">
                        <h3>Números em Ação</h3>
                        <p class="game-description">Jogo interativo para aprender matemática básica e desenvolver raciocínio lógico.</p>
                        <div class="game-tags">
                            <span class="tag">Matemática</span>
                        </div>
                        <button class="btn-play">Jogar Agora</button>
                    </div>
                </div>

                <div class="game-card-full">
                    <div class="game-image">
                        <div class="game-placeholder">🌍</div>
                    </div>
                    <div class="game-info">
                        <h3>Exploradores da Terra</h3>
                        <p class="game-description">Descubra fatos interessantes sobre geografia e biodiversidade planetária.</p>
                        <div class="game-tags">
                            <span class="tag">Ciências da Natureza</span>
                            <span class="tag">Ciências Humanas</span>
                        </div>
                        <button class="btn-play">Jogar Agora</button>
                    </div>
                </div>

                <div class="game-card-full">
                    <div class="game-image">
                        <div class="game-placeholder">📖</div>
                    </div>
                    <div class="game-info">
                        <h3>Histórias Mágicas</h3>
                        <p class="game-description">Mergulhe em histórias interativas que desenvolvem habilidades de leitura e criatividade.</p>
                        <div class="game-tags">
                            <span class="tag">Língua Portuguesa</span>
                        </div>
                        <button class="btn-play">Jogar Agora</button>
                    </div>
                </div>

                <div class="game-card-full">
                    <div class="game-image">
                        <div class="game-placeholder">🧪</div>
                    </div>
                    <div class="game-info">
                        <h3>Experimentos Científicos</h3>
                        <p class="game-description">Realize experimentos virtuais e aprenda sobre ciências de forma segura e divertida.</p>
                        <div class="game-tags">
                            <span class="tag">Ciências da Natureza</span>
                        </div>
                        <button class="btn-play">Jogar Agora</button>
                    </div>
                </div>

                <div class="game-card-full">
                    <div class="game-image">
                        <div class="game-placeholder">🎭</div>
                    </div>
                    <div class="game-info">
                        <h3>Expressão e Movimento</h3>
                        <p class="game-description">Jogo criativo que estimula expressão corporal, movimento e imaginação.</p>
                        <div class="game-tags">
                            <span class="tag">Arte</span>
                        </div>
                        <button class="btn-play">Jogar Agora</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <div class="footer-logo">
                        <img src="/logo-ludus-vertical.png" alt="Logo +LUDUS">
                    </div>
                </div>

                <div class="footer-section">
                    <h4>Navegação</h4>
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/jogos">Jogos</a></li>
                        <li><a href="/projeto">Projeto +LUDUS</a></li>
                        <li><a href="/">Equipe</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h4>Contato</h4>
                    <p>
                        <a href="mailto:ludus@ifrs.edu.br">ludus@ifrs.edu.br</a>
                    </p>
                    <div class="social-links">
                        <a href="#instagram" title="Instagram">📱</a>
                        <a href="#facebook" title="Facebook">f</a>
                        <a href="#youtube" title="YouTube">▶️</a>
                    </div>
                </div>

                <div class="footer-section">
                    <h4>♿ Acessibilidade</h4>
                    <p>Este site é acessível e segue as diretrizes WCAG 2.1 e GAIA para garantir acesso a todas as pessoas.</p>
                </div>
            </div>

            <div class="footer-bottom">
                <p>© 2026 Projeto +LUDUS - Instituto Federal Sul-rio-grandense (IFRS). Todos os direitos reservados.</p>
            </div>
        </div>
    </footer>
</body>
</html>
