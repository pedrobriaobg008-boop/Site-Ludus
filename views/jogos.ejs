<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nossos Jogos - +LUDUS</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <%- include('./header') %>

    <!-- Games Page Title -->
    <section class="games-page-title">
        <div class="container">
            <div class="page-header-content">
                <img src="/ícone controle azul.png" alt="" class="page-icon" aria-hidden="true">
                <h2>Jogos Educacionais</h2>
            </div>
            <h1>Nossos Jogos</h1>
            <p>Explore nossa coleção de jogos educacionais acessíveis<br>desenvolvidos com carinho para todas as crianças.</p>
        </div>
    </section>

    <!-- Search and Filter Section -->
    <section class="games-filter-section">
        <div class="container">
            <!-- Search Bar -->
            <div class="search-container">
                <div class="search-box">
                    <img src="/icone pesquisa rosa.png" alt="" class="search-icon" aria-hidden="true">
                    <input type="text" class="search-input" placeholder="Pesquisar jogos, categorias ou descrição">
                </div>
            </div>

            <!-- Category Filters -->
            <div class="filters-container">
                <div class="filter-label">
                    <img src="/icone filtrar rosa.png" alt="" class="filter-icon" aria-hidden="true">
                    <span>Filtrar: </span>
                </div>
                <div class="filter-buttons">
                    <button class="filter-btn active" data-filter="all">Todos</button>
                    <% if (categorias && categorias.length > 0) { %>
                        <% categorias.forEach(categoria => { %>
                            <button class="filter-btn" data-filter="<%= categoria.slug %>"><%= categoria.nome %></button>
                        <% }); %>
                    <% } %>
                </div>
            </div>
        </div>
    </section>

    <!-- Games Grid Section -->
    <section class="games-grid-section">
        <div class="container">
            <div class="tags-legend" aria-label="Legenda de cores das tags">
                <span class="legend-item">
                    <span class="legend-dot legend-dot--pink" aria-hidden="true"></span>
                    Linguagem, aprendizado e educação
                </span>
                <span class="legend-item">
                    <span class="legend-dot legend-dot--blue" aria-hidden="true"></span>
                    Exatas
                </span>
                <span class="legend-item">
                    <span class="legend-dot legend-dot--green" aria-hidden="true"></span>
                    Ciencias naturais
                </span>
                <span class="legend-item">
                    <span class="legend-dot legend-dot--orange" aria-hidden="true"></span>
                    Ciencias humanas
                </span>
            </div>
            <p class="games-counter"><%= jogos.length %> jogos encontrados</p>
            
            <div class="games-grid">
                <% jogos.forEach(jogo => { %>
                    <div class="game-card-full">
                        <div class="game-image">
                            <a href="/jogo/<%= jogo._id %>" class="game-image-link" aria-label="Abrir detalhes do jogo <%= jogo.nome %>">
                                <% if (jogo.icone_url) { %>
                                    <img src="<%= jogo.icone_url %>" alt="<%= jogo.nome %>" class="game-image-img">
                                <% } else { %>
                                    <div class="game-placeholder">
                                        <img src="/ícone controle azul.png" alt="" class="controller-icon controller-icon--placeholder" aria-hidden="true">
                                    </div>
                                <% } %>
                            </a>
                        </div>
                        <div class="game-info">
                            <h3><%= jogo.nome %></h3>
                            <p class="game-description"><%= jogo.descricao || 'Jogo educacional divertido e interativo' %></p>
                            <div class="game-tags">
                                <% if (jogo.categorias && jogo.categorias.length > 0) { %>
                                    <% jogo.categorias.forEach(cat => { %>
                                        <span class="tag"><%= cat.nome || cat %></span>
                                    <% }); %>
                                <% } else { %>
                                    <span class="tag">Educacional</span>
                                <% } %>
                            </div>
                            <a href="/jogo/<%= jogo._id %>" class="btn-play">
                                <img src="/ícone controle azul.png" alt="" class="controller-icon controller-icon--button" aria-hidden="true">
                                Abrir Jogo
                            </a>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <%- include('./footer') %>

    <script>
        const searchInput = document.querySelector('.search-input');
        const filterButtons = document.querySelectorAll('.filter-btn');
        const gameCards = document.querySelectorAll('.game-card-full');
        const gamesCounter = document.querySelector('.games-counter');
        
        let currentFilter = 'all';

        function normalizeText(text) {
            return text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
        }

        function getTagColorClass(tagText) {
            const normalizedTag = normalizeText(tagText);

            const pinkKeywords = ['linguagem', 'portugues', 'leitura', 'escrita', 'alfabetizacao', 'educacao', 'aprendizagem', 'aprendizado', 'idioma', 'literatura', 'gramatica'];
            const blueKeywords = ['matematica', 'exatas', 'logica', 'fisica', 'programacao', 'algebra', 'geometria', 'numeros', 'calculo', 'estatistica'];
            const greenKeywords = ['ciencias naturais', 'ciencias', 'biologia', 'quimica', 'natureza', 'ecologia', 'meio ambiente', 'ambiental', 'corpo humano'];
            const orangeKeywords = ['ciencias humanas', 'humanas', 'historia', 'geografia', 'sociologia', 'filosofia', 'cidadania', 'sociedade', 'cultura'];

            if (pinkKeywords.some(keyword => normalizedTag.includes(keyword))) return 'tag--pink';
            if (blueKeywords.some(keyword => normalizedTag.includes(keyword))) return 'tag--blue';
            if (greenKeywords.some(keyword => normalizedTag.includes(keyword))) return 'tag--green';
            if (orangeKeywords.some(keyword => normalizedTag.includes(keyword))) return 'tag--orange';

            return 'tag--pink';
        }

        function applyTagColors() {
            const tagColorClasses = ['tag--pink', 'tag--blue', 'tag--green', 'tag--orange'];
            const groupPriority = {
                'tag--pink': 1,
                'tag--blue': 2,
                'tag--green': 3,
                'tag--orange': 4
            };

            document.querySelectorAll('.game-tags').forEach(container => {
                const tags = Array.from(container.querySelectorAll('.tag'));

                tags.forEach(tag => {
                    tag.classList.remove(...tagColorClasses);
                    tag.classList.add(getTagColorClass(tag.textContent.trim()));
                });

                tags.sort((a, b) => {
                    const aClass = tagColorClasses.find(cls => a.classList.contains(cls)) || 'tag--pink';
                    const bClass = tagColorClasses.find(cls => b.classList.contains(cls)) || 'tag--pink';
                    const priorityDiff = groupPriority[aClass] - groupPriority[bClass];
                    if (priorityDiff !== 0) return priorityDiff;
                    return normalizeText(a.textContent.trim()).localeCompare(normalizeText(b.textContent.trim()));
                });

                tags.forEach(tag => container.appendChild(tag));
            });
        }

        function matchesFilter(card, filter) {
            if (filter === 'all') return true;
            
            const tags = card.querySelectorAll('.tag');

            // Compara categoria do botão com as tags do card usando o mesmo padrão de slug
            for (let tag of tags) {
                const tagSlug = normalizeText(tag.textContent.trim())
                    .replace(/[^a-z0-9]+/g, '-')
                    .replace(/^-+|-+$/g, '');

                if (tagSlug === filter) {
                    return true;
                }
            }
            
            return false;
        }

        function matchesSearch(card, searchTerm) {
            if (!searchTerm) return true;
            
            const normalized = normalizeText(searchTerm);
            const title = normalizeText(card.querySelector('h3').textContent);
            const description = normalizeText(card.querySelector('.game-description').textContent);
            const tags = Array.from(card.querySelectorAll('.tag')).map(t => normalizeText(t.textContent));
            
            return title.includes(normalized) || 
                   description.includes(normalized) || 
                   tags.some(tag => tag.includes(normalized));
        }

        function updateGames() {
            const searchTerm = searchInput.value;
            let visibleCount = 0;

            gameCards.forEach(card => {
                const visible = matchesFilter(card, currentFilter) && matchesSearch(card, searchTerm);
                card.style.display = visible ? 'flex' : 'none';
                if (visible) visibleCount++;
            });

            gamesCounter.textContent = `${visibleCount} jogo${visibleCount !== 1 ? 's' : ''} encontrado${visibleCount !== 1 ? 's' : ''}`;
        }

        filterButtons.forEach(button => {
            button.addEventListener('click', () => {
                document.querySelector('.filter-btn.active').classList.remove('active');
                button.classList.add('active');
                currentFilter = button.dataset.filter;
                updateGames();
            });
        });

        searchInput.addEventListener('input', () => updateGames());

        searchInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                document.querySelector('.filter-btn.active').classList.remove('active');
                document.querySelector('[data-filter="all"]').classList.add('active');
                currentFilter = 'all';
                updateGames();
                searchInput.focus();
            }
        });

        applyTagColors();
        updateGames();
    </script>
</body>
</html>
