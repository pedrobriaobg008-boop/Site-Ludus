<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= jogo.nome %> - +LUDUS</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <%- include('./header') %>

    <!-- Jogo Detalhes -->
    <section class="jogo-detalhes">
        <div class="container">
            
            <!-- Cabeçalho do Jogo -->
            <div class="jogo-header">
                <h1><%= jogo.nome %></h1>
                <div class="jogo-tags">
                    <% if (jogo.categorias && jogo.categorias.length > 0) { %>
                        <% jogo.categorias.forEach(cat => { %>
                            <span class="tag"><%= cat.nome || cat %></span>
                        <% }); %>
                    <% } else { %>
                        <span class="tag">Educacional</span>
                    <% } %>
                </div>
            </div>

            <!-- Área de Exibição do Jogo -->
            <div class="jogo-player-area">
                <div class="jogo-player-container">
                    <% if (jogo.icone_url) { %>
                        <div class="jogo-icon-container">
                            <img src="<%= jogo.icone_url %>" alt="<%= jogo.nome %>" style="max-width: 300px; max-height: 300px; object-fit: contain;">
                        </div>
                    <% } else { %>
                        <div class="jogo-icon-container">
                            <div class="jogo-icon">
                                <img src="/ícone controle azul.png" alt="" class="controller-icon controller-icon--placeholder-large" aria-hidden="true">
                            </div>
                        </div>
                    <% } %>
                </div>
                <p class="jogo-play-hint">Clique no botão "Abrir Jogo" para começar</p>
            </div>

            <!-- Descrição e Ações -->
            <div class="jogo-info-section">
                <div class="jogo-description">
                    <p><%= jogo.descricao || 'Um jogo educacional interativo e divertido!' %></p>
                    <% if (jogo.total_niveis) { %>
                        <p><strong>Níveis:</strong> <%= jogo.total_niveis %></p>
                    <% } %>
                    <% if (jogo.xp_maxima) { %>
                        <p><strong>XP Máxima:</strong> <%= jogo.xp_maxima %></p>
                    <% } %>
                </div>

                <div class="jogo-actions">
                    <% if (jogo.video_demo_url) { %>
                        <a href="<%= jogo.video_demo_url %>" target="_blank" class="btn-action">Vídeo Demo</a>
                    <% } %>
                    <% if (jogo.github_url) { %>
                        <a href="<%= jogo.github_url %>" target="_blank" class="btn-action">GitHub</a>
                    <% } %>
                </div>
            </div>

            <!-- Botão Abrir Jogo Grande -->
            <div class="jogo-play-section">
                <% if (jogo.link_jogar) { %>
                    <a href="<%= jogo.link_jogar %>" target="_blank" class="btn-play-large">
                        <img src="/ícone controle azul.png" alt="" class="controller-icon controller-icon--button-large" aria-hidden="true">
                        Abrir Jogo
                    </a>
                <% } else { %>
                    <button class="btn-play-large" disabled>
                        <img src="/ícone controle azul.png" alt="" class="controller-icon controller-icon--button-large" aria-hidden="true">
                        Em breve
                    </button>
                <% } %>
            </div>

            <!-- Jogos Relacionados -->
            <% if (jogosRelacionados && jogosRelacionados.length > 0) { %>
            <div class="relacionados-section">
                <div class="relacionados-header">
                    <h2>Jogos Relacionados</h2>
                    <a href="/jogos" class="link-all-games">Ver todos os jogos →</a>
                </div>

                <div class="games-grid">
                    <% jogosRelacionados.forEach(jogoRel => { %>
                        <div class="game-card-full">
                            <div class="game-image">
                                <% if (jogoRel.icone_url) { %>
                                    <img src="<%= jogoRel.icone_url %>" alt="<%= jogoRel.nome %>" style="width: 100%; height: 100%; object-fit: cover;">
                                <% } else { %>
                                    <div class="game-placeholder">
                                        <img src="/ícone controle azul.png" alt="" class="controller-icon controller-icon--placeholder" aria-hidden="true">
                                    </div>
                                <% } %>
                            </div>
                            <div class="game-info">
                                <h3><%= jogoRel.nome %></h3>
                                <p class="game-description"><%= jogoRel.descricao || 'Jogo educacional' %></p>
                                <div class="game-tags">
                                    <% if (jogoRel.categorias && jogoRel.categorias.length > 0) { %>
                                        <% jogoRel.categorias.forEach(cat => { %>
                                            <span class="tag"><%= cat.nome || cat %></span>
                                        <% }); %>
                                    <% } %>
                                </div>
                                <a href="/jogo/<%= jogoRel._id %>" class="btn-play">
                                    <img src="/ícone controle azul.png" alt="" class="controller-icon controller-icon--button" aria-hidden="true">
                                    Abrir Jogo
                                </a>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
            <% } %>

        </div>
    </section>

    <%- include('./footer') %>
</body>
</html>
