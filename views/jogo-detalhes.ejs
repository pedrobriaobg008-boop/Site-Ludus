<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= jogo.nome %> - +LUDUS</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <%- include('./header') %>

    <!-- Jogo Detalhes -->
    <section class="jogo-detalhes">
        <div class="container">
            
            <!-- Cabeçalho do Jogo -->
            <div class="jogo-header">
                <h1><%= jogo.nome %></h1>
                <div class="jogo-tags">
                    <% if (jogo.categorias && jogo.categorias.length > 0) { %>
                        <% jogo.categorias.forEach(cat => { %>
                            <span class="tag"><%= cat.nome || cat %></span>
                        <% }); %>
                    <% } else { %>
                        <span class="tag">Educacional</span>
                    <% } %>
                </div>
            </div>

            <!-- Área de Exibição do Jogo -->
            <div class="jogo-player-band">
                <div class="jogo-player-area">
                    <% if (jogo.link_jogar) { %>
                        <div class="jogo-iframe-shell">
                            <div class="jogo-iframe-container">
                                <iframe
                                    src="<%= jogo.link_jogar %>"
                                    class="jogo-iframe"
                                    loading="lazy"
                                    scrolling="no"
                                    allow="fullscreen; autoplay; gamepad"
                                    allowfullscreen>
                                </iframe>
                            </div>
                            <button type="button" class="btn-action btn-action--fullscreen" id="fullscreen-game-btn">
                                <span class="btn-play-label">
                                    <img src="/ícone controle branco.png" alt="" class="controller-icon controller-icon--button" aria-hidden="true">
                                    <span id="fullscreen-game-btn-label">Tela cheia</span>
                                </span>
                                <img src="/ícone extensão branco.png" alt="" class="btn-play-trailing-icon" aria-hidden="true">
                            </button>
                        </div>
                    <% } else { %>
                        <div class="jogo-player-container">
                            <% if (jogo.icone_url) { %>
                                <div class="jogo-icon-container">
                                    <img src="<%= jogo.icone_url %>" alt="<%= jogo.nome %>" style="max-width: 300px; max-height: 300px; object-fit: contain;">
                                </div>
                            <% } else { %>
                                <div class="jogo-icon-container">
                                    <div class="jogo-icon">
                                        <img src="/ícone controle azul.png" alt="" class="controller-icon controller-icon--placeholder-large" aria-hidden="true">
                                    </div>
                                </div>
                            <% } %>
                        </div>
                        <p class="jogo-play-hint">Clique no botão "Abrir Jogo" para começar</p>
                    <% } %>
                </div>
            </div>

            <!-- Descrição e Ações -->
            <div class="jogo-info-section">
                <div class="jogo-description">
                    <p><%= jogo.descricao || 'Um jogo educacional interativo e divertido!' %></p>
                    <% if (jogo.total_niveis) { %>
                        <p><strong>Níveis:</strong> <%= jogo.total_niveis %></p>
                    <% } %>
                    <% if (jogo.xp_maxima) { %>
                        <p><strong>XP Máxima:</strong> <%= jogo.xp_maxima %></p>
                    <% } %>
                </div>

                <div class="jogo-actions">
                    <% if (jogo.video_demo_url) { %>
                        <a href="<%= jogo.video_demo_url %>" target="_blank" class="btn-action">Vídeo Demo</a>
                    <% } %>
                    <% if (jogo.github_url) { %>
                        <a href="<%= jogo.github_url %>" target="_blank" class="btn-action">GitHub</a>
                    <% } %>
                </div>
            </div>

            <!-- Botão Abrir Jogo Grande -->
            <div class="jogo-play-section">
                <% if (jogo.link_jogar) { %>
                    <a href="<%= jogo.link_jogar %>" target="_blank" class="btn-play-large">
                        <span class="btn-play-label">
                            <img src="/ícone controle branco.png" alt="" class="controller-icon controller-icon--button-large" aria-hidden="true">
                            <span>Abrir Jogo</span>
                        </span>
                        <img src="/ícone extensão branco.png" alt="" class="btn-play-trailing-icon" aria-hidden="true">
                    </a>
                <% } else { %>
                    <button class="btn-play-large" disabled>
                        <span class="btn-play-label">
                            <img src="/ícone controle branco.png" alt="" class="controller-icon controller-icon--button-large" aria-hidden="true">
                            <span>Em breve</span>
                        </span>
                        <img src="/ícone extensão branco.png" alt="" class="btn-play-trailing-icon" aria-hidden="true">
                    </button>
                <% } %>
            </div>

            <!-- Jogos Relacionados -->
            <% if (jogosRelacionados && jogosRelacionados.length > 0) { %>
            <div class="relacionados-section">
                <div class="relacionados-header">
                    <h2>Jogos Relacionados</h2>
                    <a href="/jogos" class="link-all-games">Ver todos os jogos →</a>
                </div>

                <div class="games-grid">
                    <% jogosRelacionados.forEach(jogoRel => { %>
                        <div class="game-card-full">
                            <div class="game-image">
                                <% if (jogoRel.icone_url) { %>
                                    <img src="<%= jogoRel.icone_url %>" alt="<%= jogoRel.nome %>" style="width: 100%; height: 100%; object-fit: cover;">
                                <% } else { %>
                                    <div class="game-placeholder">
                                        <img src="/ícone controle azul.png" alt="" class="controller-icon controller-icon--placeholder" aria-hidden="true">
                                    </div>
                                <% } %>
                            </div>
                            <div class="game-info">
                                <h3><%= jogoRel.nome %></h3>
                                <p class="game-description"><%= jogoRel.descricao || 'Jogo educacional' %></p>
                                <div class="game-tags">
                                    <% if (jogoRel.categorias && jogoRel.categorias.length > 0) { %>
                                        <% jogoRel.categorias.forEach(cat => { %>
                                            <span class="tag"><%= cat.nome || cat %></span>
                                        <% }); %>
                                    <% } %>
                                </div>
                                <a href="/jogo/<%= jogoRel._id %>" class="btn-play">
                                    <img src="/ícone controle azul.png" alt="" class="controller-icon controller-icon--button" aria-hidden="true">
                                    Abrir Jogo
                                </a>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
            <% } %>

        </div>
    </section>

    <%- include('./footer') %>

    <script>
        function normalizeText(text) {
            return text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
        }

        function getTagColorClass(tagText) {
            const normalizedTag = normalizeText(tagText);

            const pinkKeywords = ['linguagem', 'portugues', 'leitura', 'escrita', 'alfabetizacao', 'educacao', 'aprendizagem', 'aprendizado', 'idioma', 'literatura', 'gramatica'];
            const blueKeywords = ['matematica', 'exatas', 'logica', 'fisica', 'programacao', 'algebra', 'geometria', 'numeros', 'calculo', 'estatistica'];
            const greenKeywords = ['ciencias naturais', 'ciencias', 'biologia', 'quimica', 'natureza', 'ecologia', 'meio ambiente', 'ambiental', 'corpo humano'];
            const orangeKeywords = ['ciencias humanas', 'humanas', 'historia', 'geografia', 'sociologia', 'filosofia', 'cidadania', 'sociedade', 'cultura'];

            if (pinkKeywords.some(keyword => normalizedTag.includes(keyword))) return 'tag--pink';
            if (blueKeywords.some(keyword => normalizedTag.includes(keyword))) return 'tag--blue';
            if (greenKeywords.some(keyword => normalizedTag.includes(keyword))) return 'tag--green';
            if (orangeKeywords.some(keyword => normalizedTag.includes(keyword))) return 'tag--orange';

            return 'tag--pink';
        }

        function applyDetailsTagColors() {
            const tagColorClasses = ['tag--pink', 'tag--blue', 'tag--green', 'tag--orange'];
            const groupPriority = {
                'tag--pink': 1,
                'tag--blue': 2,
                'tag--green': 3,
                'tag--orange': 4
            };

            document.querySelectorAll('.jogo-detalhes .jogo-tags, .jogo-detalhes .game-tags').forEach(container => {
                const tags = Array.from(container.querySelectorAll('.tag'));

                tags.forEach(tag => {
                    tag.classList.remove(...tagColorClasses);
                    tag.classList.add(getTagColorClass(tag.textContent.trim()));
                });

                tags.sort((a, b) => {
                    const aClass = tagColorClasses.find(cls => a.classList.contains(cls)) || 'tag--pink';
                    const bClass = tagColorClasses.find(cls => b.classList.contains(cls)) || 'tag--pink';
                    const priorityDiff = groupPriority[aClass] - groupPriority[bClass];
                    if (priorityDiff !== 0) return priorityDiff;
                    return normalizeText(a.textContent.trim()).localeCompare(normalizeText(b.textContent.trim()));
                });

                tags.forEach(tag => container.appendChild(tag));
            });
        }

        applyDetailsTagColors();

        const fullscreenButton = document.getElementById('fullscreen-game-btn');
        const fullscreenButtonLabel = document.getElementById('fullscreen-game-btn-label');
        const iframeContainer = document.querySelector('.jogo-iframe-container');
        const gameIframe = document.querySelector('.jogo-iframe');

        if (iframeContainer && gameIframe) {
            const src = (gameIframe.getAttribute('src') || '').toLowerCase();
            const looksLikeUnityEmbed = src.includes('unity') || src.includes('webgl') || src.includes('itch.io');
            if (looksLikeUnityEmbed) {
                iframeContainer.classList.add('is-unity-embed');
            }
        }

        if (fullscreenButton && iframeContainer) {
            fullscreenButton.addEventListener('click', async () => {
                try {
                    if (document.fullscreenElement) {
                        await document.exitFullscreen();
                    } else {
                        await iframeContainer.requestFullscreen();
                    }
                } catch (error) {
                    console.error('Nao foi possivel alternar tela cheia.', error);
                }
            });

            document.addEventListener('fullscreenchange', () => {
                if (fullscreenButtonLabel) {
                    fullscreenButtonLabel.textContent = document.fullscreenElement ? 'Sair da tela cheia' : 'Tela cheia';
                }
            });
        }
    </script>
</body>
</html>
