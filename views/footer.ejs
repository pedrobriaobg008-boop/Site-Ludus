<%
    const linksNavegacao = [
        { href: '/', label: 'Home' },
        { href: '/projeto', label: 'Projeto +LUDUS' },
        { href: '/jogos', label: 'Jogos' },
        { href: '/equipe', label: 'Equipe' },
        { href: '/parceiros', label: 'Parceiros' },
        { href: '/contato', label: 'Contato' }
    ];

    const secaoAtualFooter = (linksNavegacao.find((l) => l.href === currentSection) || { label: 'Navegando no site' }).label;

    const dicasPadrao = [
        'Prefira textos curtos e objetivos para reduzir carga cognitiva.',
        'Sempre verifique contraste entre texto e fundo para facilitar a leitura.',
        'Use navegação por teclado para testar se todos os elementos estão acessíveis.',
        'Padronize ícones e rótulos para tornar a interface previsível e acolhedora.'
    ];

    const dicasPorSecao = {
        '/': [
            'Na página inicial, títulos claros ajudam a encontrar conteúdo rapidamente.',
            'Agrupe informações relacionadas para reduzir distrações visuais.',
            'Elementos interativos devem ter foco visível para navegação por teclado.'
        ],
        '/jogos': [
            'Filtros consistentes facilitam a busca por jogos adequados a cada necessidade.',
            'Descrições objetivas ajudam famílias e educadores na escolha do jogo.',
            'Use botões com rótulos diretos como Abrir jogo para orientar a ação.'
        ],
        '/projeto': [
            'Textos explicativos curtos tornam a leitura mais confortável em telas menores.',
            'Hierarquia visual bem definida ajuda a compreender metas e impactos do projeto.',
            'Use contraste alto em blocos de conteúdo institucional para melhorar legibilidade.'
        ],
        '/equipe': [
            'Apresente nomes e funções com padrão visual uniforme para leitura previsível.',
            'Fotos devem manter texto alternativo quando agregarem contexto importante.',
            'Listagens em grade precisam de espaçamento consistente para evitar sobrecarga.'
        ],
        '/parceiros': [
            'Logotipos devem preservar tamanho equilibrado para evitar competição visual.',
            'Links externos de parceiros devem indicar claramente que abrem outro site.',
            'Mantenha descrições curtas para facilitar varredura por leitores de tela.'
        ],
        '/contato': [
            'Formulários devem ter rótulos explícitos e mensagens de erro claras.',
            'Informações de contato precisam estar acessíveis sem exigir rolagem extensa.',
            'Sempre combine ícone com texto para evitar ambiguidades de interpretação.'
        ]
    };

    const dicasAcessibilidade = dicasPorSecao[currentSection] || dicasPadrao;

    const indiceDicaInicial = new Date().getDate() % dicasAcessibilidade.length;
    const dicaInicial = dicasAcessibilidade[indiceDicaInicial];
    const dicasSerializadas = encodeURIComponent(JSON.stringify(dicasAcessibilidade));
%>

<!-- Footer -->
<footer class="footer">
    <div class="container">
        <div class="footer-content">
            <div class="footer-section footer-section-logo">
                <div class="footer-logo">
                    <img src="/Logo Ludus Vertical Branca (2).png" alt="Logo +LUDUS">
                </div>
            </div>

            <div class="footer-section">
                <h4>Navegação</h4>
                <ul>
                    <% linksNavegacao.forEach((link) => { %>
                        <li>
                            <a href="<%= link.href %>" <%= currentSection === link.href ? 'aria-current="page"' : '' %>>
                                <%= link.label %>
                            </a>
                        </li>
                    <% }); %>
                </ul>
            </div>

            <div class="footer-section">
                <h4>Contato</h4>
                <p class="footer-contact-line">
                    <span class="footer-inline-icon" aria-hidden="true">✉</span>
                    <a href="mailto:maisludus@gmail.com">maisludus@gmail.com</a>
                </p>
                <div class="social-links">
                    <a href="https://instagram.com/maisludus" target="_blank" rel="noopener noreferrer" title="Instagram" aria-label="Instagram">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2c2.717 0 3.056.01 4.122.06 1.065.05 1.79.217 2.428.465.66.254 1.216.598 1.772 1.153a4.908 4.908 0 0 1 1.153 1.772c.247.637.415 1.363.465 2.428.047 1.066.06 1.405.06 4.122 0 2.717-.01 3.056-.06 4.122-.05 1.065-.218 1.79-.465 2.428a4.883 4.883 0 0 1-1.153 1.772 4.915 4.915 0 0 1-1.772 1.153c-.637.247-1.363.415-2.428.465-1.066.047-1.405.06-4.122.06-2.717 0-3.056-.01-4.122-.06-1.065-.05-1.79-.218-2.428-.465a4.89 4.89 0 0 1-1.772-1.153 4.904 4.904 0 0 1-1.153-1.772c-.248-.637-.415-1.363-.465-2.428C2.013 15.056 2 14.717 2 12c0-2.717.01-3.056.06-4.122.05-1.066.217-1.79.465-2.428a4.88 4.88 0 0 1 1.153-1.772A4.897 4.897 0 0 1 5.45 2.525c.638-.248 1.362-.415 2.428-.465C8.944 2.013 9.283 2 12 2zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm6.5-.25a1.25 1.25 0 1 0-2.5 0 1.25 1.25 0 0 0 2.5 0zM12 9a3 3 0 1 1 0 6 3 3 0 0 1 0-6z"/>
                        </svg>
                    </a>
                    <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" title="Facebook" aria-label="Facebook">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M9.198 21.5h4v-8.01h3.604l.396-3.98h-4V7.5a1 1 0 0 1 1-1h3v-4h-3a5 5 0 0 0-5 5v2.01h-2l-.396 3.98h2.396v8.01z"/>
                        </svg>
                    </a>
                    <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" title="YouTube" aria-label="YouTube">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M21.593 7.203a2.506 2.506 0 0 0-1.776-1.775C18.265 5.007 12 5 12 5s-6.264-.007-7.814.404a2.56 2.56 0 0 0-1.78 1.775C2.002 8.754 2 12 2 12s-.002 3.246.407 4.814a2.56 2.56 0 0 0 1.78 1.775c1.55.41 7.814.41 7.814.41s6.265 0 7.814-.41a2.56 2.56 0 0 0 1.776-1.775C21.998 15.246 22 12 22 12s.002-3.246-.407-4.797zM9.996 15.005V8.995L15.5 12l-5.504 3.005z"/>
                        </svg>
                    </a>
                </div>
            </div>

            <div class="footer-section footer-section-dynamic" data-footer-dynamic data-tips="<%= dicasSerializadas %>">
                <h4>Acessibilidade em foco</h4>
                <p class="footer-live-line">
                    <span class="footer-live-dot" aria-hidden="true"></span>
                    <span>Seção atual: <strong><%= secaoAtualFooter %></strong></span>
                </p>
                <p class="footer-live-line">Horário local: <span class="footer-live-time" data-footer-clock>--:--:--</span></p>
                <p class="footer-tip">
                    <span class="footer-tip-label">Dica:</span>
                    <span class="footer-tip-text" data-footer-tip><%= dicaInicial %></span>
                </p>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© <span data-footer-year><%= new Date().getFullYear() %></span> Projeto +LUDUS - Instituto Federal Sul-Rio-Grandense (IFSUL). Todos os direitos reservados.</p>
            <button type="button" class="footer-back-to-top" data-footer-top-btn aria-label="Voltar ao topo da página">
                ↑ Voltar ao topo
            </button>
        </div>
    </div>
</footer>

<script>
    (function () {
        const footerDinamico = document.querySelector('[data-footer-dynamic]');
        if (!footerDinamico) {
            return;
        }

        const relogio = footerDinamico.querySelector('[data-footer-clock]');
        const dica = footerDinamico.querySelector('[data-footer-tip]');
        const ano = document.querySelector('[data-footer-year]');
        const botaoTopo = document.querySelector('[data-footer-top-btn]');
        const dicasCodificadas = footerDinamico.getAttribute('data-tips') || '';
        const prefereMenosMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        let dicas = [];
        try {
            dicas = JSON.parse(decodeURIComponent(dicasCodificadas));
        } catch (erro) {
            dicas = [];
        }

        const atualizarRelogio = function () {
            const agora = new Date();

            if (relogio) {
                relogio.textContent = agora.toLocaleTimeString('pt-BR', {
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                });
            }

            if (ano) {
                ano.textContent = String(agora.getFullYear());
            }
        };

        atualizarRelogio();
        window.setInterval(atualizarRelogio, 1000);

        if (botaoTopo) {
            botaoTopo.addEventListener('click', function () {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });
        }

        if (!dica || dicas.length <= 1) {
            return;
        }

        const transicaoDica = function (texto) {
            if (prefereMenosMovimento) {
                dica.textContent = texto;
                return;
            }

            dica.classList.add('is-changing');

            window.setTimeout(function () {
                dica.textContent = texto;
                dica.classList.remove('is-changing');
            }, 280);
        };

        let indiceAtual = Math.max(dicas.indexOf(dica.textContent.trim()), 0);

        window.setInterval(function () {
            indiceAtual = (indiceAtual + 1) % dicas.length;
            transicaoDica(dicas[indiceAtual]);
        }, 9000);
    })();
</script>
