<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Equipe +LUDUS - Jogos Educacionais Acessíveis</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <%- include('./header') %>

    <!-- Equipe Header Section -->
    <section class="equipe-header">
        <div class="container">
            <div class="equipe-badge">
                <img src="/ícone equipe azul.png" alt="" class="equipe-badge-icon" aria-hidden="true">
                <span>Nossa Equipe</span>
            </div>
            <h1>Conheça Quem Faz o +LUDUS</h1>
            <p><%= equipe.descricao %></p>
        </div>
    </section>

    <!-- Equipe Content Section -->
    <section class="equipe-content">
        <div class="container">
            <% equipe.secoes.forEach(secao => { %>
                <div class="equipe-group">
                    <div class="group-title">
                        <span class="group-icon-wrap group-icon-wrap--<%= secao.tema %>">
                            <img src="<%= secao.icone %>" alt="" class="group-icon-img" aria-hidden="true">
                        </span>
                        <h2><%= secao.titulo %></h2>
                    </div>
                    <div class="team-grid">
                        <% secao.integrantes.forEach(pessoa => { %>
                            <div class="team-card">
                                <% if (pessoa.foto) { %>
                                    <img src="<%= pessoa.foto %>" alt="Foto de <%= pessoa.nome %>" class="team-avatar-image" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                                    <div class="team-avatar team-avatar--<%= secao.tema %> team-avatar-fallback" style="display: none;"></div>
                                <% } else { %>
                                    <div class="team-avatar team-avatar--<%= secao.tema %>"></div>
                                <% } %>
                                <h3><%= pessoa.nome %></h3>
                                <p class="cargo"><%= pessoa.cargo %></p>
                                <p class="instituicao"><%= pessoa.instituicao %></p>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% }); %>

        </div>
    </section>

    <%- include('./footer') %>
</body>
</html>
