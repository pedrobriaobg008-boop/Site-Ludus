<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>+LUDUS - Jogos Educacionais Acessíveis</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <!-- Header/Navbar -->
    <header class="navbar">
        <div class="container-header">
            <div class="logo">
                <img src="/logo-ludus.png" alt="Logo +LUDUS">
            </div>
            <nav class="nav-links">
                <a href="#jogos">Jogos</a>
                <a href="#projeto">Projeto +LUDUS</a>
                <a href="#equipe">Equipe</a>
                <a href="#parceiros">Parceiros</a>
                <a href="#contato">Contato</a>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <div class="hero-text">
                    <h1>JOGOS<br>EDUCACIONAIS<br>ACESSÍVEIS PARA<br>TODOS</h1>
                    
                    <p class="hero-description">
                        O projeto +LUDUS desenvolve jogos digitais educacionais pensados especialmente para crianças autistas, pais e professores. Aprender pode ser divertido e inclusivo!
                    </p>
                    
                    <button class="btn-primary">
                        <span class="icon">🎮</span> Acessar Jogos
                    </button>
                </div>
                
                <div class="hero-image">
                    <div class="illustration-placeholder">
                        <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
                            <!-- Fundo colorido -->
                            <rect width="400" height="300" fill="#F3E5F5"/>
                            
                            <!-- Janelas/Computadores -->
                            <rect x="20" y="30" width="80" height="100" fill="#E1BEE7" rx="8"/>
                            <rect x="25" y="35" width="70" height="70" fill="#B39DDB" rx="4"/>
                            <text x="60" y="75" font-size="30">💻</text>
                            
                            <rect x="120" y="20" width="80" height="110" fill="#E1BEE7" rx="8"/>
                            <rect x="125" y="25" width="70" height="75" fill="#B39DDB" rx="4"/>
                            <text x="160" y="68" font-size="30">💻</text>
                            
                            <rect x="220" y="30" width="80" height="100" fill="#E1BEE7" rx="8"/>
                            <rect x="225" y="35" width="70" height="70" fill="#B39DDB" rx="4"/>
                            <text x="260" y="75" font-size="30">💻</text>
                            
                            <rect x="300" y="40" width="80" height="90" fill="#E1BEE7" rx="8"/>
                            <rect x="305" y="45" width="70" height="65" fill="#B39DDB" rx="4"/>
                            <text x="340" y="82" font-size="30">📱</text>
                            
                            <!-- Crianças -->
                            <circle cx="55" cy="180" r="20" fill="#D2691E"/>
                            <rect x="40" y="200" width="30" height="50" fill="#FF69B4"/>
                            
                            <circle cx="160" cy="180" r="20" fill="#8B4513"/>
                            <rect x="145" y="200" width="30" height="50" fill="#4169E1"/>
                            
                            <circle cx="260" cy="175" r="20" fill="#D2691E"/>
                            <rect x="245" y="195" width="30" height="50" fill="#9370DB"/>
                            
                            <circle cx="340" cy="185" r="20" fill="#8B4513"/>
                            <rect x="325" y="205" width="30" height="50" fill="#FFD700"/>
                            
                            <!-- Elementos decorativos -->
                            <circle cx="100" cy="150" r="8" fill="#FFB6C1" opacity="0.6"/>
                            <circle cx="300" cy="160" r="8" fill="#87CEEB" opacity="0.6"/>
                            <circle cx="50" cy="220" r="6" fill="#90EE90" opacity="0.5"/>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Jogos em Destaque -->
    <section class="featured-games">
        <div class="container">
            <div class="section-header">
                <h2>Jogos em Destaque</h2>
                <p>Explore nossa coleção de jogos educacionais acessíveis</p>
            </div>

            <div class="games-grid">
                <div class="game-card">
                    <div class="game-icon">🎮</div>
                    <h3>Mundo das Cores</h3>
                    <p>Aprenda sobre cores de forma divertida e interativa. Ideal para desenvolver habilidades visuais e cognitivas.</p>
                    <div class="game-tags">
                        <span class="tag">Cor</span>
                        <span class="tag">Linguagem</span>
                    </div>
                    <button class="btn-secondary">
                        <span>🎮</span> Abrir jogo
                    </button>
                </div>

                <div class="game-card">
                    <div class="game-icon">🎮</div>
                    <h3>Mundo das Cores</h3>
                    <p>Aprenda sobre cores de forma divertida e interativa. Ideal para desenvolver habilidades visuais e cognitivas.</p>
                    <div class="game-tags">
                        <span class="tag">Cor</span>
                        <span class="tag">Linguagem</span>
                    </div>
                    <button class="btn-secondary">
                        <span>🎮</span> Abrir jogo
                    </button>
                </div>

                <div class="game-card">
                    <div class="game-icon">🎮</div>
                    <h3>Mundo das Cores</h3>
                    <p>Aprenda sobre cores de forma divertida e interativa. Ideal para desenvolver habilidades visuais e cognitivas.</p>
                    <div class="game-tags">
                        <span class="tag">Cor</span>
                        <span class="tag">Linguagem</span>
                    </div>
                    <button class="btn-secondary">
                        <span>🎮</span> Abrir jogo
                    </button>
                </div>
            </div>

            <div class="section-footer">
                <a href="#jogos" class="link-arrow">Ver todos os jogos →</a>
            </div>
        </div>
    </section>

    <!-- Jogos pensados para todos -->
    <section class="features">
        <div class="container">
            <h2>Jogos pensados para todos</h2>
            <p>Seguimos as diretrizes WCAG 2.1 e GAIA para garantir que nossos jogos sejam acessíveis para crianças autistas e pessoas com diversas necessidades.</p>

            <div class="features-grid">
                <div class="feature-item">
                    <div class="feature-icon">👁️</div>
                    <h3>Alto Contraste</h3>
                    <p>Cores cuidadosamente escolhidas para garantir boa visibilidade e legibilidade.</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">🧠</div>
                    <h3>Baixa Carga Cognitiva</h3>
                    <p>Interfaces simples e claras, sem elementos que possam causar sobrecarga sensorial.</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">♥️</div>
                    <h3>Design Inclusivo</h3>
                    <p>Desenvolvidos seguindo WCAG 2.1 e GAIA para pessoas autistas.</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">✨</div>
                    <h3>Feedback Claro</h3>
                    <p>Respostas visuais e sonoras próximas para cada interação do usuário.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Instituição Responsável -->
    <section class="institution">
        <div class="container">
            <h2>Instituição Responsável</h2>
            <div class="institution-content">
                <svg viewBox="0 0 200 80" xmlns="http://www.w3.org/2000/svg" class="institution-logo">
                    <!-- Red dot -->
                    <circle cx="20" cy="20" r="8" fill="#DC143C"/>
                    <!-- Green grid -->
                    <rect x="15" y="15" width="8" height="8" fill="#228B22"/>
                    <rect x="25" y="15" width="8" height="8" fill="#228B22"/>
                    <rect x="35" y="15" width="8" height="8" fill="#228B22"/>
                    
                    <rect x="15" y="25" width="8" height="8" fill="#228B22"/>
                    <rect x="25" y="25" width="8" height="8" fill="#228B22"/>
                    <rect x="35" y="25" width="8" height="8" fill="#228B22"/>
                    
                    <rect x="15" y="35" width="8" height="8" fill="#00AA00"/>
                    <rect x="25" y="35" width="8" height="8" fill="#00AA00"/>
                    <rect x="35" y="35" width="8" height="8" fill="#00AA00"/>
                    
                    <!-- Text -->
                    <text x="55" y="25" font-size="14" font-weight="bold" fill="#222">INSTITUTO FEDERAL</text>
                    <text x="55" y="40" font-size="14" font-weight="bold" fill="#222">DE EDUCAÇÃO, CIÊNCIA E TECNOLOGIA</text>
                    <text x="55" y="52" font-size="12" fill="#666">Sul-rio-grandense</text>
                </svg>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <div class="footer-logo">
                        <img src="/logo-ludus.png" alt="Logo +LUDUS">
                        <span>Ludus</span>
                    </div>
                </div>

                <div class="footer-section">
                    <h4>Navegação</h4>
                    <ul>
                        <li><a href="#home">Home</a></li>
                        <li><a href="#projeto">Projeto +LUDUS</a></li>
                        <li><a href="#jogos">Jogos</a></li>
                        <li><a href="#equipe">Equipe</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h4>Contato</h4>
                    <p>
                        <a href="mailto:ludus@ifrs.edu.br">ludus@ifrs.edu.br</a>
                    </p>
                    <div class="social-links">
                        <a href="#instagram" title="Instagram">📱</a>
                        <a href="#facebook" title="Facebook">f</a>
                        <a href="#youtube" title="YouTube">▶️</a>
                    </div>
                </div>

                <div class="footer-section">
                    <h4>♿ Acessibilidade</h4>
                    <p>Este site é acessível e segue as diretrizes WCAG 2.1 e GAIA para garantir acesso a todas as pessoas.</p>
                </div>
            </div>

            <div class="footer-bottom">
                <p>© 2026 Projeto +LUDUS - Instituto Federal Sul-rio-grandense (IFRS). Todos os direitos reservados.</p>
            </div>
        </div>
    </footer>
</body>
</html>
