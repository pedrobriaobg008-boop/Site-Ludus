<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>+LUDUS - Jogos Educacionais Acessíveis</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <%- include('./header') %>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <div class="hero-text">
                    <h1>JOGOS<br>EDUCACIONAIS<br>ACESSÍVEIS PARA<br>TODOS</h1>
                    
                    <p class="hero-description">
                        Aprender pode ser divertido, acessível e inclusivo. O +LUDUS desenvolve jogos digitais pensados para aproximar educação, tecnologia e desenvolvimento infantil.
                    </p>
                    
                    <a href="/jogos" class="btn-primary">
                        <img src="/icone controle branco.png" alt="" class="icon" aria-hidden="true"> Acessar Jogos
                    </a>
                </div>
                
                <div class="hero-image">
                    <img src="/imagem diversidade.jpg" alt="Foto representando diversidade e inclusão educacional">
                </div>
            </div>
        </div>
    </section>

    <% if (jogosDestaque && jogosDestaque.length > 0) { %>
    <!-- Jogos em Destaque -->
    <section class="featured-games">
        <div class="container">
            <div class="featured-games-head">
                <div class="section-header section-header--featured">
                    <h2>Jogos em Destaque</h2>
                    <p>Explore nossa coleção de jogos educacionais acessíveis</p>
                </div>

                <a href="/jogos" class="featured-games-link">
                    Ver todos os jogos
                    <span aria-hidden="true">→</span>
                </a>
            </div>

            <div class="featured-games-grid">
                <% jogosDestaque.slice(0, 3).forEach((jogo) => { %>
                    <article class="featured-games-slot">
                        <span class="featured-games-slot-line" aria-hidden="true"></span>

                        <div class="game-card">
                            <div class="game-cover">
                                <a href="/jogo/<%= jogo._id %>" class="game-cover-link" aria-label="Abrir jogo <%= jogo.nome %>">
                                    <% if (jogo.icone_url) { %>
                                        <img src="<%= jogo.icone_url %>" alt="Capa do jogo <%= jogo.nome %>" class="game-cover-image">
                                    <% } else { %>
                                        <div class="game-cover-placeholder">
                                            <img src="/ícone controle azul.png" alt="" class="controller-icon controller-icon--placeholder" aria-hidden="true">
                                        </div>
                                    <% } %>
                                </a>
                            </div>
                            <div class="featured-game-body">
                                <%
                                    const descricaoPadraoDestaque = 'Jogo educacional acessível para todas as crianças.';
                                    const descricaoCompletaDestaque = ((jogo.descricao || descricaoPadraoDestaque) + '').trim();
                                    const limiteDescricaoDestaque = 120;
                                    const descricaoDestaqueFoiCortada = descricaoCompletaDestaque.length > limiteDescricaoDestaque;
                                    const descricaoExibidaDestaque = descricaoDestaqueFoiCortada
                                        ? `${descricaoCompletaDestaque.slice(0, limiteDescricaoDestaque).trimEnd()}`
                                        : descricaoCompletaDestaque;
                                %>
                                <h3><%= jogo.nome %></h3>
                                <p class="featured-game-description">
                                    <%= descricaoExibidaDestaque %><% if (descricaoDestaqueFoiCortada) { %><a href="/jogo/<%= jogo._id %>" class="featured-game-description-more" aria-label="Continuar lendo a descrição do jogo <%= jogo.nome %>">...</a><% } %>
                                </p>
                                <div class="game-tags">
                                    <% if (jogo.categorias && jogo.categorias.length > 0) { %>
                                        <% jogo.categorias.slice(0, 2).forEach((cat) => { %>
                                            <span class="tag"><%= cat.nome || cat %></span>
                                        <% }); %>
                                    <% } else { %>
                                        <span class="tag">Educacional</span>
                                    <% } %>
                                </div>
                                <a href="/jogo/<%= jogo._id %>" class="btn-secondary btn-secondary--featured">
                                    <span class="btn-secondary-label">
                                        <img src="/icone controle branco.png" alt="" class="controller-icon controller-icon--button-featured" aria-hidden="true">
                                        <span>Abrir Jogo</span>
                                    </span>
                                    <svg class="btn-secondary-trailing-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M14 5h5v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M10 14 19 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M19 13v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </article>
                <% }); %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- Jogos pensados para todos -->
    <section class="features">
        <div class="container">
            <h2>Jogos pensados para todos</h2>
            <p>Jogos pensados para aprender e incluir
                Desenvolvemos experiências digitais acessíveis que auxiliam educadores, famílias e profissionais no apoio ao aprendizado e
            desenvolvimento infantil.</p>

            <div class="features-grid">
                <div class="feature-item">
                    <div class="feature-icon-wrapper">
                        <img src="/icone olho rosa.png" alt="" class="feature-icon" aria-hidden="true">
                    </div>
                    <h3>Alto Contraste</h3>
                    <p>Cores cuidadosamente escolhidas para garantir boa visibilidade e legibilidade.</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon-wrapper">
                        <img src="/icone cerebro rosa.png" alt="" class="feature-icon" aria-hidden="true">
                    </div>
                    <h3>Baixa Carga Cognitiva</h3>
                    <p>Interfaces simples e claras, sem elementos que possam causar sobrecarga sensorial.</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon-wrapper">
                        <img src="/icone coracao rosa.png" alt="" class="feature-icon" aria-hidden="true">
                    </div>
                    <h3>Design Inclusivo</h3>
                    <p>Desenvolvidos seguindo WCAG 2.1 e GAIA para pessoas autistas.</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon-wrapper">
                        <img src="/icone brilho rosa.png" alt="" class="feature-icon" aria-hidden="true">
                    </div>
                    <h3>Feedback Claro</h3>
                    <p>Respostas visuais e sonoras próximas para cada interação do usuário.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Instituição Responsável -->
    <section class="institution">
        <div class="container">
            <h2>Instituição Responsável</h2>
            <div class="institution-content">
                <img src="/logo ifsul bage.png" alt="Instituto Federal Sul-rio-grandense" class="institution-logo">
            </div>
        </div>
    </section>

    <%- include('./footer') %>

    <script>
        function normalizeText(text) {
            return text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
        }

        function getTagColorClass(tagText) {
            const normalizedTag = normalizeText(tagText);

            const pinkKeywords = ['linguagem', 'portugues', 'leitura', 'escrita', 'alfabetizacao', 'educacao', 'aprendizagem', 'aprendizado', 'idioma', 'literatura', 'gramatica'];
            const blueKeywords = ['matematica', 'exatas', 'logica', 'fisica', 'programacao', 'algebra', 'geometria', 'numeros', 'calculo', 'estatistica'];
            const greenKeywords = ['ciencias naturais', 'ciencias', 'biologia', 'quimica', 'natureza', 'ecologia', 'meio ambiente', 'ambiental', 'corpo humano'];
            const orangeKeywords = ['ciencias humanas', 'humanas', 'historia', 'geografia', 'sociologia', 'filosofia', 'cidadania', 'sociedade', 'cultura'];

            if (pinkKeywords.some(keyword => normalizedTag.includes(keyword))) return 'tag--pink';
            if (blueKeywords.some(keyword => normalizedTag.includes(keyword))) return 'tag--blue';
            if (greenKeywords.some(keyword => normalizedTag.includes(keyword))) return 'tag--green';
            if (orangeKeywords.some(keyword => normalizedTag.includes(keyword))) return 'tag--orange';

            return 'tag--pink';
        }

        function applyFeaturedTagColors() {
            const tagColorClasses = ['tag--pink', 'tag--blue', 'tag--green', 'tag--orange'];
            const tags = document.querySelectorAll('.featured-games .game-tags .tag');

            tags.forEach(tag => {
                tag.classList.remove(...tagColorClasses);
                tag.classList.add(getTagColorClass(tag.textContent.trim()));
            });
        }

        applyFeaturedTagColors();
    </script>
</body>
</html>
