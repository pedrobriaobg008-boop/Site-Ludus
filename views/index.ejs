<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>+LUDUS - Jogos Educacionais Acessíveis</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <!-- Header/Navbar -->
    <header class="navbar">
        <div class="container-header">
            <div class="logo">
                <img src="/logo-ludus.png" alt="Logo +LUDUS">
                <span>Ludus</span>
            </div>
            <nav class="nav-links">
                <a href="#jogos">Jogos</a>
                <a href="#projeto">Projeto +LUDUS</a>
                <a href="#equipe">Equipe</a>
                <a href="#parceiros">Parceiros</a>
                <a href="#contato">Contato</a>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <div class="hero-text">
                    <h1>JOGOS<br>EDUCACIONAIS<br>ACESSÍVEIS PARA<br>TODOS</h1>
                    
                    <p class="hero-description">
                        O projeto +LUDUS desenvolve jogos digitais educacionais pensados especialmente para crianças autistas, pais e professores. Aprender pode ser divertido e inclusivo!
                    </p>
                    
                    <button class="btn-primary">
                        <span class="icon">🎮</span> Acessar Jogos
                    </button>
                </div>
                
                <div class="hero-image">
                    <div class="illustration-placeholder">
                        <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
                            <!-- Fundo colorido -->
                            <rect width="400" height="300" fill="#F3E5F5"/>
                            
                            <!-- Janelas/Computadores -->
                            <rect x="20" y="30" width="80" height="100" fill="#E1BEE7" rx="8"/>
                            <rect x="25" y="35" width="70" height="70" fill="#B39DDB" rx="4"/>
                            <text x="60" y="75" font-size="30">💻</text>
                            
                            <rect x="120" y="20" width="80" height="110" fill="#E1BEE7" rx="8"/>
                            <rect x="125" y="25" width="70" height="75" fill="#B39DDB" rx="4"/>
                            <text x="160" y="68" font-size="30">💻</text>
                            
                            <rect x="220" y="30" width="80" height="100" fill="#E1BEE7" rx="8"/>
                            <rect x="225" y="35" width="70" height="70" fill="#B39DDB" rx="4"/>
                            <text x="260" y="75" font-size="30">💻</text>
                            
                            <rect x="300" y="40" width="80" height="90" fill="#E1BEE7" rx="8"/>
                            <rect x="305" y="45" width="70" height="65" fill="#B39DDB" rx="4"/>
                            <text x="340" y="82" font-size="30">📱</text>
                            
                            <!-- Crianças -->
                            <circle cx="55" cy="180" r="20" fill="#D2691E"/>
                            <rect x="40" y="200" width="30" height="50" fill="#FF69B4"/>
                            
                            <circle cx="160" cy="180" r="20" fill="#8B4513"/>
                            <rect x="145" y="200" width="30" height="50" fill="#4169E1"/>
                            
                            <circle cx="260" cy="175" r="20" fill="#D2691E"/>
                            <rect x="245" y="195" width="30" height="50" fill="#9370DB"/>
                            
                            <circle cx="340" cy="185" r="20" fill="#8B4513"/>
                            <rect x="325" y="205" width="30" height="50" fill="#FFD700"/>
                            
                            <!-- Elementos decorativos -->
                            <circle cx="100" cy="150" r="8" fill="#FFB6C1" opacity="0.6"/>
                            <circle cx="300" cy="160" r="8" fill="#87CEEB" opacity="0.6"/>
                            <circle cx="50" cy="220" r="6" fill="#90EE90" opacity="0.5"/>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Navigation dots (carousel) -->
    <div class="carousel-controls">
        <button class="dot active"></button>
        <button class="dot"></button>
        <button class="dot"></button>
    </div>
</body>
</html>
