<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>+LUDUS - Jogos Educacionais Acessíveis</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <%- include('./header') %>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <div class="hero-text">
                    <h1>JOGOS<br>EDUCACIONAIS<br>ACESSÍVEIS PARA<br>TODOS</h1>
                    
                    <p class="hero-description">
                        O projeto +LUDUS desenvolve jogos digitais educacionais pensados especialmente para crianças autistas, pais e professores. Aprender pode ser divertido e inclusivo!
                    </p>
                    
                    <a href="/jogos" class="btn-primary">
                        <img src="/ícone controle azul.png" alt="" class="icon" aria-hidden="true"> Acessar Jogos
                    </a>
                </div>
                
                <div class="hero-image">
                    <img src="/imagem diversidade.jpg" alt="Foto representando diversidade e inclusão educacional">
                </div>
            </div>
        </div>
    </section>

    <% if (jogosDestaque && jogosDestaque.length > 0) { %>
    <!-- Jogos em Destaque -->
    <section class="featured-games">
        <div class="container">
            <div class="section-header">
                <h2>Jogos em Destaque</h2>
                <p>Explore nossa coleção de jogos educacionais acessíveis</p>
            </div>

            <div class="games-grid">
                <% jogosDestaque.forEach(jogo => { %>
                    <div class="game-card">
                        <div class="game-cover">
                            <% if (jogo.icone_url) { %>
                                <img src="<%= jogo.icone_url %>" alt="Capa do jogo <%= jogo.nome %>" class="game-cover-image">
                            <% } else { %>
                                <div class="game-cover-placeholder">
                                    <img src="/ícone controle azul.png" alt="" class="controller-icon controller-icon--placeholder" aria-hidden="true">
                                </div>
                            <% } %>
                        </div>
                        <h3><%= jogo.nome %></h3>
                        <p><%= jogo.descricao || 'Jogo educacional acessível para todas as crianças.' %></p>
                        <div class="game-tags">
                            <% if (jogo.categorias && jogo.categorias.length > 0) { %>
                                <% jogo.categorias.slice(0, 2).forEach(cat => { %>
                                    <span class="tag"><%= cat.nome || cat %></span>
                                <% }); %>
                            <% } else { %>
                                <span class="tag">Educacional</span>
                            <% } %>
                        </div>
                        <a href="/jogo/<%= jogo._id %>" class="btn-secondary">
                            <img src="/ícone controle azul.png" alt="" class="controller-icon controller-icon--button" aria-hidden="true">
                            Abrir jogo
                        </a>
                    </div>
                <% }); %>
            </div>

            <div class="section-footer">
                <a href="/jogos" class="link-arrow">Ver todos os jogos →</a>
            </div>
        </div>
    </section>
    <% } %>

    <!-- Jogos pensados para todos -->
    <section class="features">
        <div class="container">
            <h2>Jogos pensados para todos</h2>
            <p>Seguimos as diretrizes WCAG 2.1 e GAIA para garantir que nossos jogos sejam acessíveis para crianças autistas e pessoas com diversas necessidades.</p>

            <div class="features-grid">
                <div class="feature-item">
                    <div class="feature-icon">👁️</div>
                    <h3>Alto Contraste</h3>
                    <p>Cores cuidadosamente escolhidas para garantir boa visibilidade e legibilidade.</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">🧠</div>
                    <h3>Baixa Carga Cognitiva</h3>
                    <p>Interfaces simples e claras, sem elementos que possam causar sobrecarga sensorial.</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">♥️</div>
                    <h3>Design Inclusivo</h3>
                    <p>Desenvolvidos seguindo WCAG 2.1 e GAIA para pessoas autistas.</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">✨</div>
                    <h3>Feedback Claro</h3>
                    <p>Respostas visuais e sonoras próximas para cada interação do usuário.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Instituição Responsável -->
    <section class="institution">
        <div class="container">
            <h2>Instituição Responsável</h2>
            <div class="institution-content">
                <img src="/logo-ifsul.png" alt="Instituto Federal Sul-rio-grandense" class="institution-logo">
            </div>
        </div>
    </section>

    <%- include('./footer') %>
</body>
</html>
