<!-- Header/Navbar -->
<header class="navbar">
    <div class="container-header">
        <a href="/" class="logo" <%= currentSection === '/' ? 'aria-current="page"' : '' %>>
            <img src="/Azul Horizontal (3).png" alt="Logo +LUDUS">
        </a>
        <nav class="nav-links" aria-label="Navegação principal">
            <a href="/jogos" <%= currentSection === '/jogos' ? 'aria-current="page"' : '' %>>
                <img src="/ícone controle azul.png" alt="" class="nav-icon-jogos" aria-hidden="true">
                <span class="nav-text-jogos">Jogos</span>
            </a>
            <a href="/artigos" class="nav-artigos" <%= currentSection === '/artigos' ? 'aria-current="page"' : '' %>>
                <img src="/ícone livro azul.png" alt="" class="nav-icon-artigos" aria-hidden="true">
                <span class="nav-text-artigos">Artigos</span>
            </a>
            <a href="/projeto" class="nav-projeto" <%= currentSection === '/projeto' ? 'aria-current="page"' : '' %>>
                <img src="/icone informacao azul (2).png" alt="" class="nav-icon-projeto" aria-hidden="true">
                <span class="nav-text-projeto-container">
                    <span class="nav-text-projeto">Projeto +LUDUS</span>
                </span>
            </a>
            <a href="/equipe" class="nav-equipe" <%= currentSection === '/equipe' ? 'aria-current="page"' : '' %>>
                <img src="/ícone equipe azul.png" alt="" class="nav-icon-equipe" aria-hidden="true">
                <span class="nav-text-equipe">Equipe</span>
            </a>
            <a href="/parceiros" class="nav-parceiros" <%= currentSection === '/parceiros' ? 'aria-current="page"' : '' %>>
                <img src="/Ícone Parceiros Azul.png" alt="" class="nav-icon-parceiros" aria-hidden="true">
                <span class="nav-text-parceiros">Parceiros</span>
            </a>
            <a href="/contato" class="nav-contato" <%= currentSection === '/contato' ? 'aria-current="page"' : '' %>>
                <img src="/Ícone Contato Azul.png" alt="" class="nav-icon-contato" aria-hidden="true">
                <span class="nav-text-contato">Contato</span>
            </a>
        </nav>
        <button class="profile-toggle" type="button" data-profile-toggle aria-expanded="false" aria-controls="user-profile-panel" aria-haspopup="dialog">
            <span class="profile-toggle-avatar" data-profile-nav-avatar aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.7"/><path d="M5 20v-2a7 7 0 0 1 14 0v2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
            </span>
            <span class="profile-toggle-copy">
                <span class="profile-toggle-name" data-profile-nav-name>Meu perfil</span>
                <span class="profile-toggle-detail" data-profile-nav-detail>Entrar</span>
            </span>
            <svg class="profile-toggle-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
    </div>
</header>
<%- include('./user-profile') %>
<script src="/scripts/user-profile.js" defer></script>
